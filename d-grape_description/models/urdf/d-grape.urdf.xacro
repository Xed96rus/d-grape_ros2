<?xml version="1.0"?>

<robot name="d-grape" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Arguments -->
  <xacro:arg name="sim" default="true" />
  <xacro:arg name="robot_name" default="d-grape" />
  <xacro:arg name="namespace" default="" />  
  <xacro:arg name="frame_prefix" default="" />
 
  <!-- Robot model -->
  <xacro:include filename="$(find d-grape_description)/models/urdf/d-grape_model.urdf.xacro" />

  <!-- Simulation hardware interface -->
  <xacro:if value="$(arg sim)">
    <xacro:include filename="$(find d-grape_description)/models/urdf/d-grape_sim_hardware_interface.urdf.xacro" />
  </xacro:if>
  <!-- <xacro:include filename="$(find d-grape_description)/models/urdf/d-grape_control.urdf.xacro" /> -->

</robot>